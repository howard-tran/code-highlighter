{
	"name": "highlight",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"icon": "resource/icon_2.png",
	"repository": {
		"url": "https://github.com/howard-tran/code-highlighter"
	},
	"author": {
		"name": "howard",
		"email": "mingkhoitran1234@gmail.com"
	},
	"publisher": "M1nt-Ch0c0",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.47.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "highlight.selectedWords",
				"title": "%command.highlightSelectedWords.title%"
			},
			{
				"command": "highlight.clearWords",
				"title": "%command.clearHighlightWords.title%"
			},
			{
				"command": "highlight.showLog",
				"title": "%command.showLog.title%"
			},
			{
				"command": "highlight.toggleHighlight",
				"title": "%command.toggleHighlight.title%"
			},
			{
				"command": "highlight.toggleOnlySelectedOccurrence",
				"title": "%command.toggleOnlySelectedOccurrence.title%"
			},
			{
				"command": "highlight.toggleRenderStyle",
				"title": "%command.toggleRenderStyle.title%"
			},
			{
				"command": "highlight.saveHighlights",
				"title": "%command.saveHighlights.title%"
			},
			{
				"command": "highlight.loadHighlights",
				"title": "%command.loadHighlights.title%"
			}
		],
		"keybindings": [
			{
				"command": "highlight.selectedWords",
				"key": "shift+f8"
			},
			{
				"command": "highlight.clearWords",
				"key": "ctrl+shift+f8"
			},
			{
				"command": "highlight.toggleHighlight",
				"key": "ctrl+alt+f8"
			}
		],
		"configuration": [
			{
				"title": "%config.title%",
				"properties": {
					"highlight.configuration.wholeWord": {
						"type": "boolean",
						"default": true,
						"description": "%config.wholeWord.description%"
					},
					"highlight.configuration.ignoreCase": {
						"type": "boolean",
						"default": false,
						"description": "%config.ignoreCase.description%"
					},
					"highlight.configuration.Bold": {
						"type": "boolean",
						"default": true,
						"description": "%config.bold.description%"
					},
					"highlight.configuration.borderRadius": {
						"type": "string",
						"default": "5px",
						"description": "%config.borderRadius.description%"
					},
					"highlight.configuration.renderStyle": {
						"type": "string",
						"enum": [
							"highlight",
							"text"
						],
						"enumDescriptions": [
							"%config.renderStyle.enum.highlight%",
							"%config.renderStyle.enum.text%"
						],
						"default": "highlight",
						"description": "%config.renderStyle.description%"
					},
					"highlight.configuration.onlySelectedOccurrence": {
						"type": "boolean",
						"default": false,
						"description": "%config.onlySelectedOccurrence.description%"
					},
					"highlight.configuration.debug": {
						"type": "boolean",
						"default": true,
						"description": "%config.debug.description%"
					},
					"highlight.configuration.disableHighlight": {
						"type": "boolean",
						"default": false,
						"description": "%config.disableHighlight.description%"
					},
					"highlight.configuration.colors": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"name": {
									"type": "string",
									"description": "%config.colors.item.name%"
								},
								"light": {
									"type": "string",
									"description": "%config.colors.item.light%"
								},
								"dark": {
									"type": "string",
									"description": "%config.colors.item.dark%"
								},
								"textLight": {
									"type": "string",
									"description": "%config.colors.item.textLight%"
								},
								"textDark": {
									"type": "string",
									"description": "%config.colors.item.textDark%"
								}
							}
						},
						"default": [
							{
