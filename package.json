{
	"name": "highlight",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"icon": "resource/icon.png",
	"repository": {
		"url": "https://github.com/M1nt-Ch0c0/vscode-extension-highlight"
	},
	"author": {
		"name": "M1nt-Ch0c0"
	},
	"publisher": "M1nt-Ch0c0",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.47.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "highlight.selectedWords",
				"title": "%command.highlightSelectedWords.title%"
			},
			{
				"command": "highlight.clearWords",
				"title": "%command.clearHighlightWords.title%"
			},
			{
				"command": "highlight.showLog",
				"title": "%command.showLog.title%"
			}
		],
		"keybindings": [
			{
				"command": "highlight.selectedWords",
				"key": "shift+f8"
			},
			{
				"command": "highlight.clearWords",
				"key": "ctrl+shift+f8"
			}
		],
		"configuration": [
			{
				"title": "%config.title%",
				"properties": {
					"highlight.configuration.wholeWord": {
						"type": "boolean",
						"default": true,
						"description": "%config.wholeWord.description%"
					},
					"highlight.configuration.ignoreCase": {
						"type": "boolean",
						"default": false,
						"description": "%config.ignoreCase.description%"
					},
					"highlight.configuration.Bold": {
						"type": "boolean",
						"default": true,
						"description": "%config.bold.description%"
					},
					"highlight.configuration.borderRadius": {
						"type": "string",
						"default": "5px",
						"description": "%config.borderRadius.description%"
					},
					"highlight.configuration.onlySelectedOccurrence": {
						"type": "boolean",
						"default": false,
						"description": "%config.onlySelectedOccurrence.description%"
					},
					"highlight.configuration.debug": {
						"type": "boolean",
						"default": true,
						"description": "%config.debug.description%"
					},
					"highlight.configuration.colors": {
						"type": "array",
						"default": [
							{
								"name": "red-1",
								"light": "#F2D7D5",
